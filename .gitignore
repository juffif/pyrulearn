# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual / conda environments (machine-specific)
.conda/
.venv/
venv/
env/

# Tools and editors
.pytest_cache/
.vscode/
.idea/
.claude/
.env
*.log

# Local scratch work (never published)
work/

# Files regenerated by the demos / benchmarks
examples/_*_arff/
examples/_*_cache/
examples/__pycache__/
demos/_*_arff/
demos/_*_cache/
demos/__pycache__/
# A demo's quick/no-args-default output -- a sample from its full run is
# committed instead (see the demo's own module docstring).
examples/*_quick_report.md
examples/*_quick*.png
examples/*/*_quick*.png
demos/*_quick_report.md
demos/*_quick*.png
demos/*/*_quick*.png
